Options -Indexes

RewriteEngine On

RewriteRule ^sitemap\.xml$ sitemap.php [L]

RewriteRule ^tool/([a-z0-9-]+)/?$ /tool/index.php?slug=$1 [L,QSA]

RewriteRule ^category/([a-z0-9-]+)/?$ /category/index.php?slug=$1 [L,QSA]

RewriteRule ^go/([a-z0-9-]+)/?$ /go.php?slug=$1 [L,QSA]

<Files "config.php">
    Require all denied
</Files>