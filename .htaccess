Options -Indexes

RewriteEngine On

# ─────────────────────────────────────────────────────────────────────────────
# 1. GOOGLE VERIFICATION & SITEMAP SPECIAL HEADERS
# ─────────────────────────────────────────────────────────────────────────────
<Files "googlee71d85bbb3e57211.html">
    Require all granted
    ForceType text/plain
    Header set Content-Type "text/plain; charset=utf-8"
</Files>

# ─────────────────────────────────────────────────────────────────────────────
# 2. CANONICAL REDIRECTS (HTTPS & non-www)
# ─────────────────────────────────────────────────────────────────────────────
# Force HTTPS (supports direct Apache, reverse proxies, and Cloudflare)
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTP:CF-Visitor} '"scheme":"http"' [OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} =""
RewriteRule ^ https://hdropshipping.com%{REQUEST_URI} [L,R=301]

# Force non-www canonical host
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ─────────────────────────────────────────────────────────────────────────────
# 3. LEGACY / QUERY-STRING 301 REDIRECTS
# ─────────────────────────────────────────────────────────────────────────────
# /politique.php -> /privacy.php
RewriteRule ^politique\.php$ /privacy.php [L,R=301]

# /tool/index.php?slug=xxx -> /tool/xxx
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+/tool/index\.php\?slug=([a-z0-9-]+) [NC]
RewriteRule ^ /tool/%1? [L,R=301]

# /category/index.php?slug=xxx -> /category/xxx
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+/category/index\.php\?slug=([a-z0-9-]+) [NC]
RewriteRule ^ /category/%1? [L,R=301]

# ─────────────────────────────────────────────────────────────────────────────
# 4. CLEAN ROUTING & REWRITES
# ─────────────────────────────────────────────────────────────────────────────
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^tool/([a-z0-9-]+)/?$ /tool/index.php?slug=$1 [L,QSA]
RewriteRule ^category/([a-z0-9-]+)/?$ /category/index.php?slug=$1 [L,QSA]
RewriteRule ^go/([a-z0-9-]+)/?$ /go.php?slug=$1 [L,QSA]

# Custom 404 Error Document
ErrorDocument 404 /404.php

# ─────────────────────────────────────────────────────────────────────────────
# 5. SECURITY: PROTECT SENSITIVE FILES
# ─────────────────────────────────────────────────────────────────────────────
<FilesMatch "^(\.env|\.git|config\.php|dropshipping_stack\.sql)">
    Require all denied
</FilesMatch>

# ══════════════════════════════════════════════════════════════════════════════
# PERFORMANCE OPTIMIZATIONS (Gzip Compression & Browser Caching)
# Safe for shared hosting (AwardSpace) behind Cloudflare
# ══════════════════════════════════════════════════════════════════════════════

# 1. Gzip Compression via mod_deflate
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
</IfModule>

# 2. Browser Expiration Rules via mod_expires
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML & XML: fresh
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"

    # CSS & JavaScript: 1 month (uses ?v= cache-busting query strings)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # Images: 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Fonts: 1 year
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# 3. HTTP Headers & Cache-Control via mod_headers
<IfModule mod_headers.c>
    # Dynamic Pages: revalidate
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>

    # CSS & JS: public cache 1 month (2592000s)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Images & Fonts: public cache 1 year (31536000s, immutable)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|ttf|otf|woff|woff2|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
